# Runtime variables required by the FastAPI REST application.
DB_USER
DB_PASSWORD
{%- if language == "java" %}
{%- if java_framework == "helidon" or java_framework == "helidon4" %}
JAVAX_SQL_DATASOURCE_DS1_DATASOURCE_URL
{%- endif %}
JDBC_URL
{%- else %} 
DB_URL
{%- endif %}    
{%- if db_type == "nosql" %}
TF_VAR_nosql_endpoint
{%- endif %}
{%- if python_framework in [ "langgraph", "responses" ] %}
TF_VAR_compartment_ocid
TF_VAR_region
PROJECT_OCID              
MCP_SERVER_URL
{%- endif %}
